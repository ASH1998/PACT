# PACT Backend Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./pact.db

# Server
HOST=0.0.0.0
PORT=8000

# Issuer Keys (Ed25519 — leave blank to auto-generate on first run)
# These override the file-based fallback at backend/keys/issuer_keys.json
PACT_ISSUER_PRIVATE_KEY=
PACT_ISSUER_PUBLIC_KEY=
