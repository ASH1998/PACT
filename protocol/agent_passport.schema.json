{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Passport",
  "description": "Signed identity document for an AI agent.",
  "type": "object",
  "required": [
    "agent_id",
    "owner",
    "agent_type",
    "public_key",
    "allowed_domains",
    "risk_tier",
    "issued_at",
    "expires_at",
    "issuer_signature"
  ],
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Unique identifier for the agent."
    },
    "owner": {
      "type": "string",
      "description": "Team or organization that owns the agent."
    },
    "agent_type": {
      "type": "string",
      "description": "Functional type of the agent (e.g. email_assistant, web_researcher)."
    },
    "public_key": {
      "type": "string",
      "description": "Ed25519 public key (base64-encoded)."
    },
    "allowed_domains": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Tool domains the agent is permitted to use."
    },
    "risk_tier": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Risk classification of this agent."
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "description": "Passport issuance timestamp (ISO 8601)."
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Passport expiry timestamp (ISO 8601)."
    },
    "issuer_signature": {
      "type": "string",
      "description": "Ed25519 signature of the passport fields by the issuer key (base64-encoded)."
    }
  }
}
